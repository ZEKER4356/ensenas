# ==============================================================================
# PLATAFORMA ENSEÑAS - VARIABLES DE ENTORNO (.env)
# ==============================================================================

# Entorno de ejecución
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. Base de Datos PostgreSQL Gestionada (InsForge / Supabase / Neon)
# ------------------------------------------------------------------------------
# Cadena de conexión estándar PostgreSQL (Pooler o Directa)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 2. Credenciales de InsForge / Supabase (API REST & Cloud Storage)
# ------------------------------------------------------------------------------
# URL del proyecto backend en la nube
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_ID].supabase.co
# o INSFORGE_API_URL=https://[PROJECT_ID].insforge.app

# Clave pública anónima (para lecturas públicas directas desde cliente o visor)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Clave secreta con privilegios de servicio (SOLO en backend Serverless de Vercel)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Nombre del bucket de almacenamiento para medios
STORAGE_BUCKET_NAME=ensenas-media

# ------------------------------------------------------------------------------
# 3. Autenticación y Seguridad del Panel /admin
# ------------------------------------------------------------------------------
# Clave secreta para firma y verificación de tokens JWT de sesión de administradores
JWT_SECRET=super_secreto_para_firma_jwt_ensenas_2026_seguro_min32chars

# Credenciales maestras del administrador inicial para primer despliegue
ADMIN_DEFAULT_EMAIL=admin@ensenas.edu.co
ADMIN_DEFAULT_PASSWORD=EnsenasAdmin2026!

# ------------------------------------------------------------------------------
# 4. Configuración Pública de la Aplicación
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://ensenas.vercel.app
