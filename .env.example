# ==============================================================================
# PLATAFORMA ENSEÑAS - VARIABLES DE ENTORNO (.env)
# ==============================================================================

# Copia este archivo como .env.local solo para tu computador. No subas ese
# archivo a Git ni pegues estos valores en el navegador.
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Base de Datos (elige SOLO una alternativa)
# ------------------------------------------------------------------------------
# Cadena de conexión estándar PostgreSQL (Pooler o Directa)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 2. Credenciales de InsForge / Supabase (API REST & Cloud Storage)
# ------------------------------------------------------------------------------
# En Supabase Dashboard: Connect / Settings > API Keys.
SUPABASE_URL=https://[PROJECT_ID].supabase.co

# Clave secreta (sb_secret_...). SOLO para Vercel y .env.local; jamás la pongas
# en HTML, JavaScript de assets/ ni la compartas por chat.
SUPABASE_SECRET_KEY=pega_aqui_tu_clave_secreta

# Nombre del bucket de almacenamiento para medios
STORAGE_BUCKET_NAME=ensenas-media

# ------------------------------------------------------------------------------
# 3. Autenticación y Seguridad del Panel /admin
# ------------------------------------------------------------------------------
# Clave secreta para firma y verificación de tokens JWT de sesión de administradores
JWT_SECRET=crea_una_frase_aleatoria_larga_de_32_caracteres_o_mas

# ------------------------------------------------------------------------------
# 4. Configuración Pública de la Aplicación
# ------------------------------------------------------------------------------
PUBLIC_APP_URL=https://tu-proyecto.vercel.app
